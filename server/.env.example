PORT=8080
NODE_ENV=development

# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dungeon_crawler

# Session Secret (IMPORTANT: Generate a strong random secret!)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_session_secret_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ============================================================
# EMAIL CONFIGURATION
# ============================================================

# OPTION 1: Gmail (Recommended for testing with real emails)
# 2. Go to: https://myaccount.google.com/apppasswords

EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=your-gmail@gmail.com

# OPTION 2: Ethereal Mail (Auto-configured for testing)

# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM="Dungeon Crawler <noreply@dungeoncrawler.com>"
